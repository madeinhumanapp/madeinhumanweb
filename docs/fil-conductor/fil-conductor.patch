+      m.forEach((p, i) => {
+        p.r = 0; p.la = o.ona || 0; p.s = this.s + p.d; p.u = this.u + p.d * (L / Ls[k]);
+        tr = Math.max(i ? tr + CONFIG.pas * CONFIG.kmin : tr, p.y - CONFIG.lectura * this.vh); p.trig = tr;
+      });
+      fins.push(tr);
+    });
