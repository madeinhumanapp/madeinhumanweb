# Capçaleres de seguretat (WEB-E01). Pages serveix /pagina.html com a /pagina (redirecció 308): les excepcions
# s'escriuen per a totes dues adreces. Cloudflare aplica totes les regles que coincideixen amb una ruta;
# «! Capçalera» treu la que hagi posat una regla anterior (així cada excepció té una sola CSP completa).
# Les comprova npm run csp (cada pàgina es carrega amb aquestes capçaleres i no hi pot haver cap infracció).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Imatges i vídeos de la biblioteca (WEB-M02): el nom porta l'empremta del contingut, no canvien mai
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Pàgina d'enllaços de les xarxes: no s'indexa (tampoc és al sitemap)
/xarxes/*
  X-Robots-Tag: noindex

# Portada (formularis de contacte i d'adequació): control antirobots de Cloudflare (Turnstile, turnstile.js)
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
/index.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Diagnòstic: deixa preparat el control antibots de Cloudflare (Turnstile), que s'activa des de rgpd-tool
/diagnostic.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
/diagnostic
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Recollida de dades: l'assistent compila el seu codi al navegador (Babel) i necessita 'unsafe-eval' i 'unsafe-inline'
/recollida.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
/recollida
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://rgpd.madeinhuman.cat; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Vista prèvia del panell: només es pot inserir des de rgpd-tool i no s'indexa
/_previsualitzacio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src blob:; form-action 'none'; frame-ancestors https://rgpd.madeinhuman.cat; base-uri 'self'; object-src 'none'
  X-Robots-Tag: noindex
